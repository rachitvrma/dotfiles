#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
  default_album_art_path: None,
  format_tag_separator: " | ",
  browser_column_widths: [20, 38, 42],
  // base16 palette (yours):
  // base00 #141617  base01 #1d2021  base02 #282828  base03 #5a524c
  // base04 #bdae93  base05 #ddc7a1  base06 #ebdbb2  base07 #fbf1c7
  // base08 #ea6962  base09 #e78a4e  base0A #d8a657  base0B #a9b665
  // base0C #89b482  base0D #7daea3 (secondary accent)  base0E #d3869b (primary accent)
  // base0F #bd6f3e
  background_color: "#141617",        // base00
  text_color: "#ddc7a1",               // base05
  header_background_color: "#1d2021", // base01
  modal_background_color: "#1d2021",  // base01
  modal_backdrop: false,
  preview_label_style: (fg: "#d8a657"),                              // base0A yellow
  preview_metadata_group_style: (fg: "#d8a657", modifiers: "Bold"),  // base0A yellow
  highlighted_item_style: (fg: "#7daea3", modifiers: "Bold"),          // base0D blue
  current_item_style: (fg: "#141617", bg: "#d3869b", modifiers: "Bold"), // base00 on base0E magenta (primary accent)
  borders_style: (fg: "#7daea3"),         // base0D blue
  highlight_border_style: (fg: "#d3869b"), // base0E magenta (primary accent)
  // inserted by me
  cava:(
    bar_width: 1, // width of a single bar in columns
    bar_spacing: 1, // free space between bars in columns
    bg_color: "#141617", // matches cava.conf [color] background / base00
    orientation: Bottom, // bars grow bottom-up, matching cava's vertical gradient direction
    // cycles through the full accent palette
    bar_color: Gradient({
      0:   "rgb(234, 105,  98)",  // base08 - red    (#ea6962)
      16:  "rgb(231, 138,  78)",  // base09 - orange (#e78a4e)
      33:  "rgb(216, 166,  87)",  // base0A - yellow (#d8a657)
      50:  "rgb(169, 182, 101)",  // base0B - green  (#a9b665)
      66:  "rgb(137, 180, 130)",  // base0C - aqua   (#89b482)
      83:  "rgb(125, 174, 163)",  // base0D - blue   (#7daea3)
      100: "rgb(211, 134, 155)",  // base0E - magenta(#d3869b)
    })
  ),
  symbols: (
    song: "S",
    dir: "D",
    playlist: "P",
    marker: "M",
    ellipsis: "...",
    song_style: None,
    dir_style: None,
    playlist_style: None,
  ),
  level_styles: (
    info: (fg: "#7daea3", bg: "#141617"),   // base0D blue
    warn: (fg: "#d8a657", bg: "#141617"),   // base0A yellow
    error: (fg: "#ea6962", bg: "#141617"),  // base08 red
    debug: (fg: "#a9b665", bg: "#141617"),  // base0B green
    trace: (fg: "#d3869b", bg: "#141617"),  // base0E magenta
  ),
  progress_bar: (
    symbols: ["█", "█", "█", " ", "█"],
    track_style: None,
    elapsed_style: (fg: "#d3869b"),  // base0E magenta (primary accent)
    thumb_style: (fg: "#d3869b"),    // base0E magenta
    use_track_when_empty: true,
  ),
  scrollbar: (
    symbols: ["│", "█", "▲", "▼"],
    track_style: (),
    ends_style: (),
    thumb_style: (fg: "#7daea3"), // base0D blue
  ),
  tab_bar: (
    active_style: (fg: "#141617", bg: "#d3869b", modifiers: "Bold"), // base00 on base0E magenta
    inactive_style: (),
  ),
  lyrics: (
    timestamp: false
  ),
  browser_song_format: [
  (
      kind: Group([
      (kind: Property(Track)),
      (kind: Text(" ")),
      ])
    ),
  (
      kind: Group([
      (kind: Property(Artist)),
      (kind: Text(" - ")),
      (kind: Property(Title)),
      ]),
      default: (kind: Property(Filename))
    ),
  ],
  song_table_format: [
  (
      prop: (kind: Property(Artist),
        default: (kind: Text("Unknown"))
      ),
      label_prop: (kind: Text("Artist")),
      width: "20%",
    ),
  (
      prop: (kind: Property(Title),
        default: (kind: Text("Unknown"))
      ),
      label_prop: (kind: Text("Title")),
      width: "35%",
    ),
  (
      prop: (kind: Property(Album), style: (fg: "#ebdbb2"),
        default: (kind: Text("Unknown Album"), style: (fg: "#ebdbb2"))
      ),
      label_prop: (kind: Text("Album")),
      width: "30%",
    ),
  (
      prop: (kind: Property(Duration),
        default: (kind: Text("-"))
      ),
      label_prop: (kind: Text("Duration")),
      width: "15%",
      alignment: Right,
    ),
  ],
  layout: Split(
    direction: Vertical,
    panes: [
    (
        size: "4",
        pane: Split(
          direction: Horizontal,
          panes: [
          (
              size: "35",
              borders: "LEFT | TOP | BOTTOM",
              border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
              pane: Component("header_left")
            ),
          (
              size: "100%",
              borders: "ALL",
              border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
              pane: Component("header_center")
            ),
          (
              size: "35",
              borders: "RIGHT | TOP | BOTTOM",
              border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
              pane: Component("header_right")
            ),
          ]
        )
      ),
    (
        pane: Pane(Tabs),
        borders: "RIGHT | LEFT | BOTTOM",
        border_symbols: Rounded,
        size: "2",
      ),
    (
        pane: Pane(TabContent),
        size: "100%",
      ),
    (
        size: "3",
        pane: Split(
          direction: Horizontal,
          panes: [
          (
              size: "12",
              borders: "ALL",
              border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
              pane: Component("input_mode")
            ),
          (
              size: "100%",
              borders: "TOP | BOTTOM | RIGHT",
              border_symbols: Rounded,
              border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
              border_title_alignment: Right,
              pane: Component("progress_bar"),
            ),
          ]
        ),
      ),
    ],
  ),
  components: {
    "state": Pane(Property(
      content: [
      (kind: Text("["), style: (fg: "#d8a657", modifiers: "Bold")),   // base0A yellow
      (kind: Property(Status(StateV2( ))), style: (fg: "#d8a657", modifiers: "Bold")),
      (kind: Text("]"), style: (fg: "#d8a657", modifiers: "Bold")),
      ], align: Left,
    )),
    "title": Pane(Property(
      content: [
      (kind: Property(Song(Title)), style: (modifiers: "Bold"),
          default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
      ], align: Center, scroll_speed: 1
    )),
    "volume": Split(
      direction: Horizontal,
      panes: [
      (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
      (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
      (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#7daea3"))], align: Right))), // base0D blue
      (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#7daea3"))]))), // base0D blue
      ]
    ),
    "elapsed_and_bitrate": Pane(Property(
      content: [
      (kind: Property(Status(Elapsed))), 
      (kind: Text(" / ")), 
      (kind: Property(Status(Duration))), 
      (kind: Group([
        (kind: Text(" (")), 
        (kind: Property(Status(Bitrate))), 
        (kind: Text(" kbps)")),
        ])),
      ],
      align: Left,
    )),
    "artist_and_album": Pane(Property(
      content: [
      (kind: Property(Song(Artist)), style: (fg: "#d8a657", modifiers: "Bold"), // base0A yellow
          default: (kind: Text("Unknown"), style: (fg: "#d8a657", modifiers: "Bold"))),
      (kind: Text(" - ")),
      (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
      ], align: Center, scroll_speed: 1
    )),
    "states": Split(
      direction: Horizontal,
      panes: [
      (
          size: "1",
          pane: Pane(Empty())
        ),
      (
          size: "100%",
          pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#7daea3"), align: Left)])) // base0D blue
        ),
      (
          size: "6",
          pane: Pane(Property(content: [
          (kind: Text("["), style: (fg: "#7daea3", modifiers: "Bold")), // base0D blue
          (kind: Property(Status(RepeatV2(
              on_label: "z",
              off_label: "z",
              on_style: (fg: "#a9b665", modifiers: "Bold"),   // base0B green - "on" = active
              off_style: (fg: "#7daea3", modifiers: "Dim"),   // base0D blue - "off" = resting
            )))),
          (kind: Property(Status(RandomV2(
              on_label: "x",
              off_label: "x",
              on_style: (fg: "#a9b665", modifiers: "Bold"),
              off_style: (fg: "#7daea3", modifiers: "Dim"),
            )))),
          (kind: Property(Status(ConsumeV2(
              on_label: "c",
              off_label: "c",
              oneshot_label: "c",
              on_style: (fg: "#a9b665", modifiers: "Bold"),
              off_style: (fg: "#7daea3", modifiers: "Dim"),
              oneshot_style: (fg: "#ea6962", modifiers: "Dim"), // base08 red - distinct "in-between" state
            )))),
          (kind: Property(Status(SingleV2(
              on_label: "v",
              off_label: "v",
              oneshot_label: "v",
              on_style: (fg: "#a9b665", modifiers: "Bold"),
              off_style: (fg: "#7daea3", modifiers: "Dim"),
              oneshot_style: (fg: "#ea6962", modifiers: "Bold"),
            )))),
          (kind: Text("]"), style: (fg: "#7daea3", modifiers: "Bold")), // base0D blue
          ],
            align: Right
          ))
        ),
      ]
    ),
    "input_mode": Pane(Property(
      content: [
      (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
        (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#141617", bg: "#7daea3"))), // base00 on base0D blue
        (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#141617", bg: "#a9b665"))), // base00 on base0B green
        ])))
      ], align: Center
    )),
    "header_left": Split(
      direction: Vertical,
      panes: [
      (size: "1", pane: Component("state")),
      (size: "1", pane: Component("elapsed_and_bitrate")),
      ]
    ),
    "header_center": Split(
      direction: Vertical,
      panes: [
      (size: "1", pane: Component("title")),
      (size: "1", pane: Component("artist_and_album")),
      ]
    ),
    "header_right": Split(
      direction: Vertical,
      panes: [
      (size: "1", pane: Component("volume")),
      (size: "1", pane: Component("states")),
      ]
    ),
    "progress_bar": Split(
      direction: Horizontal,
      panes: [
      (
          size: "1",
          pane: Pane(Empty())
        ),
      (
          size: "100%",
          pane: Pane(ProgressBar)
        ),
      (
          size: "1",
          pane: Pane(Empty())
        ),
      ]
    )
  },
)
