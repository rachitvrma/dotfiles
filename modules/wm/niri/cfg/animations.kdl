animations {
  workspace-switch {
    spring damping-ratio=1.0 stiffness=1400 epsilon=0.0001
  }

  window-open {
    duration-ms 220
    curve "cubic-bezier" 0.34 1.56 0.64 1

    custom-shader r"
      vec4 open_color(vec3 coords_geo, vec3 size_geo) {
          // Pop in from 85% scale (close to Hyprland's popin 87%).
          float scale = mix(0.85, 1.0, niri_progress);
          vec3 coords = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);

          vec4 color = vec4(0.0);
          if (0.0 <= coords.x && coords.x <= 1.0 && 0.0 <= coords.y && coords.y <= 1.0) {
              vec3 coords_tex = niri_geo_to_tex * coords;
              color = texture2D(niri_tex, coords_tex.st);

              // Thin magenta rim-light along the window edge while it's popping in,
              // echoing the Gruvbox Material accent (base0E, #d3869b).
              float edge_dist = min(min(coords.x, 1.0 - coords.x), min(coords.y, 1.0 - coords.y));
              float rim = smoothstep(0.05, 0.0, edge_dist) * (1.0 - niri_clamped_progress);
              vec3 accent = vec3(0.827, 0.525, 0.607);
              color.rgb = mix(color.rgb, accent, rim * 0.6);
          }

          color *= niri_clamped_progress;
          return color;
      }
    "
  }

  window-close {
    duration-ms 220
    curve "linear"

    custom-shader r"
      vec4 close_color(vec3 coords_geo, vec3 size_geo) {
          float progress = niri_clamped_progress;

          // Shrink to 85% scale as it closes (mirrors the open animation's popin).
          float scale = mix(1.0, 0.85, progress);
          vec3 coords = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);

          vec4 color = vec4(0.0);
          if (0.0 <= coords.x && coords.x <= 1.0 && 0.0 <= coords.y && coords.y <= 1.0) {
              vec3 coords_tex = niri_geo_to_tex * coords;
              color = texture2D(niri_tex, coords_tex.st);
          }

          // Per-pixel noise dissolve, seeded per-window so every close looks a little
          // different. Pixels drop out in step with progress instead of a flat fade.
          float n = fract(sin(dot(coords_geo.xy * 80.0, vec2(12.9898, 78.233)))
              * (43758.5453 + niri_random_seed * 1000.0));
          if (n < progress) {
              color = vec4(0.0);
          }

          color *= (1.0 - progress);
          return color;
      }
    "
  }

  horizontal-view-movement {
    spring damping-ratio=1.0 stiffness=1400 epsilon=0.0001
  }

  window-movement {
    spring damping-ratio=0.94 stiffness=850 epsilon=0.0001
  }

  window-resize {
    spring damping-ratio=0.94 stiffness=850 epsilon=0.0001
  }

  config-notification-open-close {
    duration-ms 303
    curve "cubic-bezier" 0.15 0 0.1 1
  }

  screenshot-ui-open {
    duration-ms 381
    curve "cubic-bezier" 0.23 1 0.32 1
  }

  overview-open-close {
    duration-ms 400
    curve "cubic-bezier" 0.23 1 0.32 1
  }

  recent-windows-close {
    duration-ms 150
    curve "linear"
  }
}
